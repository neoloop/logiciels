# Inscription d'application Azure AD (Microsoft Entra ID) - voir README.md
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Secret utilisé par NextAuth pour signer les sessions (générer avec: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Nombre de jours d'attente avant de proposer une relance (peut aussi être changé dans l'UI)
DEFAULT_FOLLOW_UP_DELAY_DAYS=3
