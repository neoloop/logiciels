# --- Serveur du relais ---
PORT=3000
# Clé partagée que l'app iOS doit envoyer dans l'en-tête X-Relay-Api-Key
RELAY_API_KEY=change-me
# Intervalle d'interrogation de GLPI, en secondes
POLL_INTERVAL_SECONDS=180

# --- Compte de service GLPI ---
# Ce compte doit avoir un profil pouvant voir les tickets de tous les
# techniciens que le relais doit surveiller (ex : profil Admin ou Super-Admin,
# ou un profil dédié avec droit de lecture globale sur les tickets).
GLPI_URL=https://glpi.exemple.com
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# --- Mapping des champs de recherche GLPI (avancé) ---
# Doit correspondre aux réglages "Mapping des champs" de l'app iOS.
GLPI_FIELD_ID=2
GLPI_FIELD_TITLE=1
GLPI_FIELD_STATUS=12
GLPI_FIELD_ASSIGNED_TECHNICIAN=5

# --- APNs (Apple Push Notification service), authentification par jeton ---
# Clé .p8 créée dans le Apple Developer Portal (Certificates, Identifiers & Profiles > Keys)
APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
# Identifiant de bundle de l'app iOS (topic APNs)
APNS_BUNDLE_ID=com.neoloop.glpiinterventions
# true en production (App Store / TestFlight), false pour un build de développement
APNS_PRODUCTION=false

# --- Stockage local ---
DATA_FILE=./data/relay-store.json
